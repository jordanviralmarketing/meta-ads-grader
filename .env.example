# Copy to .env for local reference. .env is gitignored.
# The app reads the process environment only; it does not load this file.
# Export the variables yourself, or set them in the Render service environment.
#
# Required. The app will not start without this. Use a placeholder here,
# never a real Meta app secret.
META_APP_SECRET=replace-with-meta-app-secret

# Required. Use a long random value on Render
# (for example: python -c "import secrets; print(secrets.token_hex(32))").
# The session cookie itself is only an opaque id. Never commit the real value.
FLASK_SECRET_KEY=replace-with-long-random-value

# Optional. Public Meta app id. Leave unset to use the built-in default.
META_APP_ID=

# Optional. OAuth redirect URI. Leave unset to use the production callback.
REDIRECT_URI=https://meta-ads-grader.onrender.com/auth/meta/callback

# Optional. 301 from meta-ads-grader.onrender.com to
# https://grader.theviralmarketingcompany.com. Unset stays on.
# Set to 0, false, no, or off to disable.
# ONRENDER_HOST_REDIRECT=0

# Optional. Booking link shown on the report and thank-you pages.
STRATEGY_SESSION_URL=

# Optional. Conversions API token for server-side GraderGradeView events.
# Leave unset to skip that call. Never commit a real token.
META_CAPI_ACCESS_TOKEN=

# Optional. When set, CAPI events include this test_event_code.
# Leave unset for live events. Never commit a real code.
# META_CAPI_TEST_EVENT_CODE=

# Optional. Directory for server-side sessions and saved reports.
# Default: a folder under the system temp dir (ephemeral on Render).
# Attach a disk and set this to its mount path to keep reports across deploys.
DATA_DIR=

# Optional. Session backend. Default cachelib stores sessions as files and
# puts only an opaque id in the cookie. filesystem is an alias.
# sqlalchemy (with DATABASE_URL and flask-sqlalchemy) is the later database switch.
SESSION_TYPE=cachelib

# Optional. Where grade reports are stored. sqlite uses the stdlib.
REPORT_STORE=sqlite

# Optional. Override the secure session cookie. On Render this is already on
# because Render sets RENDER=true. Set false only for local HTTP.
SESSION_COOKIE_SECURE=

# Optional SMTP settings. Unused by the current routes.
# SMTP_PASSWORD has no default credential.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
